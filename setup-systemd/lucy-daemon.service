[Unit]
Description=Lucy Notes Daemon
After=network.target

[Service]
Type=simple

# IMPORTANT: set working directory to the project root
WorkingDirectory=/home/user/demon_lucy

ExecStart=/usr/bin/python3 /home/user/demon_lucy/main_daemon.py --sys-config-path /home/user/Notes/.lucy/config.txt

Restart=on-failure
RestartSec=2

Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target
